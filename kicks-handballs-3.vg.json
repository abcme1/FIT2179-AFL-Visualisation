{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "description": "An HD-tier custom normalized stacked bar chart mapping tactical style distribution.",
  "width": 650,
  "height": 400,
  "data": {
    "url": "../stacked bar 3/kicks vs handballs.csv"
  },
  "transform": [
    {
      "fold": ["kicks", "handballs"],
      "as": ["disposal_type", "count"]
    }
  ],
  "config": {
    "view": {"stroke": "transparent"},
    "axis": {
      "labelFont": "Arial, sans-serif",
      "titleFont": "Arial, sans-serif"
    }
  },
  "mark": {
    "type": "bar",
    "stroke": "#ffffff",
    "strokeWidth": 1.5,
    "cornerRadius": 3
  },
  "encoding": {
    "x": {
      "field": "player_team",
      "type": "nominal",
      "title": "AFL Team",
      "sort": {
        "op": "mean",
        "field": "count",
        "order": "descending"
      },
      "axis": {
        "labelAngle": -45,
        "labelPadding": 8,
        "labelOverlap": false,
        "ticks": false,
        "domain": false
      }
    },
    "y": {
      "field": "count",
      "type": "quantitative",
      "stack": "normalize",
      "title": "Tactical Distribution Mix (%)",
      "axis": {
        "format": "%",
        "grid": true,
        "gridColor": "#f1f5f9",
        "ticks": false,
        "domain": false
      }
    },
    "color": {
      "field": "disposal_type",
      "type": "nominal",
      "title": null,
      "scale": {
        "domain": ["kicks", "handballs"],
        "range": ["#2b5c8f", "#e68a4b"]
      },
      "legend": {
        "orient": "top",
        "padding": 15,
        "labelExpr": "datum.label == 'kicks' ? 'Kicks' : 'Handballs'",
        "labelFontSize": 12,
        "labelFontWeight": "bold"
      }
    },
    "tooltip": [
      {"field": "player_team", "type": "nominal", "title": "Team"},
      {"field": "disposal_type", "type": "nominal", "title": "Type"},
      {"field": "count", "type": "quantitative", "title": "Volume"}
    ]
  }
}