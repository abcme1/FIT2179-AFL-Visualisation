{
  "$schema": "https://vega.github.io/schema/vega-lite/v5.json",
  "title": "AFL Player Density Origin Draft by State (2020-2025)",
  "width": 700,
  "height": 500,
  "autosize": {"type": "fit", "contains": "padding"},
  "view": {"stroke": "transparent"},
  "projection": {
    "type": "mercator",
    "center": [133.7751, -27.5],
    "scale": 640
  },
  "params": [
    {
      "name": "Select_Year",
      "value": 2025,
      "bind": {
        "input": "range",
        "min": 2020,
        "max": 2025,
        "step": 1,
        "name": "Year: "
      }
    }
  ],
  "layer": [
    {
      "data": {
        "url": "topjson-AUS-1.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_1_states_provinces"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.admin == 'Australia'"
        }
      ],
      "mark": {
        "type": "geoshape",
        "fill": "#e0e0e0",
        "stroke": "white",
        "strokeWidth": 1
      }
    },
    {
      "data": {
        "url": "topjson-AUS-1.json",
        "format": {
          "type": "topojson",
          "feature": "ne_50m_admin_1_states_provinces"
        }
      },
      "transform": [
        {
          "filter": "datum.properties.admin == 'Australia'"
        },
        {
          "lookup": "properties.name",
          "from": {
            "data": {
              "url": "afl-draft-origin-1.csv"
            },
            "key": "State / Territory",
            "fields": ["Density (per 100k)", "AFL Players", "Year", "State / Territory"]
          }
        },
        {
          "filter": "datum['Year'] == Select_Year"
        }
      ],
      "mark": {
        "type": "geoshape",
        "stroke": "white",
        "strokeWidth": 1.5,
        "opacity": 0.95
      },
      "encoding": {
        "color": {
          "field": "Density (per 100k)",
          "type": "quantitative",
          "scale": {
            "scheme": "oranges",
            "domain": [0, 1.2]
          },
          "legend": {
            "title": "Players per 100k",
            "orient": "right",
            "offset": 10
          }
        },
        "tooltip": [
          {"field": "State / Territory", "type": "nominal", "title": "State"},
          {"field": "Density (per 100k)", "type": "quantitative", "format": ".2f", "title": "Density (per 100k)"},
          {"field": "AFL Players", "type": "quantitative", "title": "Total AFL Players"}
        ]
      }
    }
  ]
}
